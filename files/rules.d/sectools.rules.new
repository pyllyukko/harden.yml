-a always,exit -F path=/var/lib/aide/aide.db -F perm=wa -k sectools
-a always,exit -F path=/etc/aide.conf -F perm=wa -k sectools
-a always,exit -F dir=/etc/aide/ -F perm=wa -k sectools
-a always,exit -F dir=/var/lib/rkhunter/db/ -F perm=wa -k sectools
-a always,exit -F path=/etc/rkhunter.conf -F perm=wa -k sectools
-a always,exit -F path=/usr/sbin/unhide -F perm=wa -k sectools
-a always,exit -F path=/usr/sbin/unhide-linux -F perm=wa -k sectools
-a always,exit -F path=/usr/sbin/unhide-posix -F perm=wa -k sectools
-a always,exit -F path=/usr/sbin/unhide-tcp -F perm=wa -k sectools
-a always,exit -F path=/usr/sbin/unhide_rb -F perm=wa -k sectools
-a always,exit -F path=/usr/bin/rkhunter -F perm=wa -k sectools
-a always,exit -F path=/usr/bin/sockstat -F perm=wa -k sectools
-a always,exit -F path=/usr/bin/readelf -F perm=wa -k sectools
# Slackware
-a always,exit -F path=/sbin/ss -F perm=wa -k sectools
# Debian
-a always,exit -F path=/usr/bin/ss -F perm=wa -k sectools
