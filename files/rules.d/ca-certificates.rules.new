-a always,exit -F path=/etc/ca-certificates.conf -F perm=wa -k ca-certificates
-a always,exit -F dir=/etc/ssl/certs/ -F perm=wa -F key=ca-certificates
-a always,exit -F dir=/etc/ca-certificates/ -F perm=wa -F key=ca-certificates
-a always,exit -F dir=/usr/local/share/ca-certificates/ -F perm=wa -F key=ca-certificates
-a always,exit -F path=/usr/sbin/update-ca-certificates -F perm=x -k ca-certificates
