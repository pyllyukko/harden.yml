## From https://github.com/Neo23x0/auditd/blob/master/audit.rules
## Cron configuration & scheduled jobs
-a always,exit -F path=/etc/cron.allow -F perm=wa -k cron
-a always,exit -F path=/etc/cron.deny -F perm=wa -k cron
-a always,exit -F dir=/etc/cron.d/ -F perm=wa -k cron
-a always,exit -F dir=/etc/cron.daily/ -F perm=wa -k cron
-a always,exit -F dir=/etc/cron.hourly/ -F perm=wa -k cron
-a always,exit -F dir=/etc/cron.monthly/ -F perm=wa -k cron
-a always,exit -F dir=/etc/cron.weekly/ -F perm=wa -k cron
-a always,exit -F path=/etc/crontab -F perm=wa -k cron
## https://github.com/Neo23x0/auditd/issues/83
-a always,exit -F dir=/var/spool/cron/ -F perm=wa -k cron
