# Further additions to STIG MAC rule(s)
-a always,exit -F dir=/etc/apparmor.d/ -F perm=wa -F key=MAC-policy
-a always,exit -F dir=/etc/apparmor/ -F perm=wa -k MAC-policy
-a always,exit -F path=/sbin/setenforce -F perm=x -k MAC-policy
-a always,exit -F path=/sbin/semanage -F perm=x -k MAC-policy
-a always,exit -F path=/sbin/setsebool -F perm=x -k MAC-policy
-a always,exit -F path=/sbin/restorecon -F perm=x -k MAC-policy
-a always,exit -F path=/bin/chcon -F perm=x -k MAC-policy
-a always,exit -F path=/sbin/genhomedircon -F perm=x -k MAC-policy
-a always,exit -F path=/sbin/semodule -F perm=x -k MAC-policy
-a always,exit -F path=/usr/sbin/aa-enforce -F perm=x -k MAC-policy
-a always,exit -F path=/usr/sbin/aa-disable -F perm=x -k MAC-policy
-a always,exit -F path=/usr/sbin/aa-complain -F perm=x -k MAC-policy
-a always,exit -F path=/usr/sbin/aa-audit -F perm=x -k MAC-policy
